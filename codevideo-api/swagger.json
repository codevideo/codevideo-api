{
  "openapi": "3.0.0",
  "info": {
    "title": "CodeVideo API",
    "description": "API for generating videos based on specified actions",
    "version": "1.0.0"
  },
  "paths": {
    "/create-video-v3": {
      "post": {
        "summary": "Create a video immediately (for testing purposes)",
        "description": "Create a video immediately with the specified actions",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RequestBodyV3"
              }
            }
          }
        }
      }
    },
    "/create-video-immediately": {
      "post": {
        "summary": "Create a video immediately (for testing purposes)",
        "description": "Create a video immediately with the specified actions",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RequestBody"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Video created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "url": {
                      "type": "string",
                      "example": "https://fullstackcraft.s3.us-east-1.amazonaws.com/codevideo/47a2ad38-3364-4031-972a-2d7705de2d4a.mp4"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string",
                      "example": "Internal Server Error"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "RequestBodyV3": {
        "type": "object",
        "properties": {
          "project": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/IAction"
            },
            "description": "Actions array, or an ILesson / ICourse object."
          },
          "actions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/IAction"
            },
            "description": "Legacy alias for project (actions array)."
          },
          "options": {
            "$ref": "#/components/schemas/CreateVideoOptions"
          }
        }
      },
      "CreateVideoOptions": {
        "type": "object",
        "description": "Optional render settings. Unknown keys are ignored. resolution and orientation are accepted now but only take effect once the render worker is updated.",
        "properties": {
          "voiceId": { "type": "string", "description": "Overrides the active TTS provider's default voice (Kokoro voice name or ElevenLabs voice id).", "example": "af_heart" },
          "resolution": { "type": "string", "enum": ["1080p", "4K"], "example": "1080p" },
          "orientation": { "type": "string", "enum": ["landscape", "portrait"], "example": "landscape" },
          "theme": { "type": "string", "enum": ["light", "dark"], "example": "dark" },
          "withCaptions": { "type": "boolean", "example": true },
          "fontSizePx": { "type": "number", "example": 26 },
          "fileExplorerWidth": { "type": "number", "example": 400 },
          "terminalHeight": { "type": "number", "example": 350 },
          "mouseColor": { "type": "string", "example": "black" },
          "isFileExplorerVisible": { "type": "boolean", "example": true },
          "isTerminalVisible": { "type": "boolean", "example": true },
          "keyboardTypingPauseMs": { "type": "number", "example": 40 },
          "standardPauseMs": { "type": "number", "example": 200 },
          "longPauseMs": { "type": "number", "example": 2000 },
          "defaultLanguage": { "type": "string", "example": "javascript" }
        }
      },
      "RequestBody": {
        "type": "object",
        "properties": {
          "actions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/IAction"
            }
          },
          "language": {
            "$ref": "#/components/schemas/language"
          },
          "textToSpeechOption": {
            "$ref": "#/components/schemas/textToSpeechOption"
          }
        }
      },
      "IAction": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "The name of the action to perform",
            "example": "author-speak-before"
          },
          "value": {
            "type": "string",
            "description": "The value of the action",
            "example": "I'm going to log \"Hello, world!\" to the console."
          }
        }
      },
      "language": {
        "type": "string",
        "example": "javascript"
      },
      "textToSpeechOption": {
        "type": "string",
        "example": "festival"
      }
    }
  }
}
