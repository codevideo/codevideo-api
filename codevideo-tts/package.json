{
  "name": "codevideo-tts",
  "version": "0.1.0",
  "description": "Self-hosted, vendor-free text-to-speech for CodeVideo (Kokoro, pure Node). OpenAI-compatible /v1/audio/speech.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "type-check": "tsc --noEmit",
    "smoke": "tsx scripts/smoke.ts"
  },
  "dependencies": {
    "express": "^4.21.2",
    "kokoro-js": "^1.2.1",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "typescript": "^5.8.2"
  }
}
